<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_proxmox"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/proxmox_empty_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Bağlantı yok"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/proxmox_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/node_dot_1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_server_unit" />

        <TextView
            android:id="@+id/proxmox_summary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="3/3"
            android:textColor="@color/widget_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="çevrimiçi"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
