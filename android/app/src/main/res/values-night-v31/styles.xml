<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) SplashScreen API, koyu sistem modu. Bkz.
  values-v31/styles.xml'in üstündeki not — aynı gerekçeyle tam yeniden
  tanımlanıyor. İkon @drawable/splash_mark, drawable-night/ niteleyicisi
  sayesinde burada da otomatik açık tonlu (koyu zemine uygun) çözülür.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
