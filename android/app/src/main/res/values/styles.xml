<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- MTools açık tema zemini (app_theme.dart — classic/isDark:false
             bg) — Flutter'ın kendi splash_screen.dart'ına devrede renk
             sıçraması olmasın diye aynı hex. -->
        <item name="android:colorBackground">#F7F7F8</item>
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:colorBackground">#F7F7F8</item>
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Proxmox/WOL widget yapılandırma ekranları (ConfigureActivity) için.
         Önceden Theme.DeviceDefault.Light kullanılıyordu ama Activity'nin
         kendisi içeriği elle @color/widget_bg (koyu) ile boyuyordu — Light
         temanın kendi windowBackground'ı (beyaz) ekranın Activity'nin
         boyamadığı kısımlarında (ör. içerik ekranı doldurmadığında ScrollView
         altında kalan alan, veya ilk çizim karesi) görünüyor, "yarı beyaz
         yarı siyah" görünümüne yol açıyordu. windowBackground'ı doğrudan
         tema seviyesinde @color/widget_bg yaparak bu boşluk kapatılıyor —
         widget'ların kendisi zaten (sistem/uygulama temasından bağımsız)
         hep bu sabit koyu paletle çizildiği için (bkz. colors.xml), bu ekran
         da aynı sabit paleti kullanıyor. -->
    <style name="WidgetConfigureTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/widget_bg</item>
        <item name="android:colorBackground">@color/widget_bg</item>
        <item name="android:statusBarColor">@color/widget_bg</item>
        <item name="android:navigationBarColor">@color/widget_bg</item>
    </style>
</resources>
